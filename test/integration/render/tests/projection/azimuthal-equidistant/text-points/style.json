{
  "version": 8,
  "metadata": {
    "test": {
      "description": "Labels stay upright; the label south of the outer ring is hidden.",
      "height": 256,
      "width": 256
    }
  },
  "center": [
    0,
    90
  ],
  "zoom": -0.9,
  "glyphs": "local://glyphs/{fontstack}/{range}.pbf",
  "projection": {
    "type": "azimuthal-equidistant"
  },
