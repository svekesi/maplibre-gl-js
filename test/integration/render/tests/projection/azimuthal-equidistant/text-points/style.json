    {
      "id": "dots",
      "type": "circle",
      "source": "geojson",
      "paint": {
        "circle-radius": 3,
        "circle-color": "#d00000"
      }
    },
    {
      "id": "text",
      "type": "symbol",
      "source": "geojson",
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Open Sans Semibold",
          "Arial Unicode MS Bold"
        ],
        "text-size": 10,
        "text-offset": [
          0,
          1
        ],
        "text-allow-overlap": true
